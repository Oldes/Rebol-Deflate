;-    .-.                                                                       
;-   /'v'\   SISKIN-Builder project file                                        
;-  (/uOu\)  https://github.com/Siskin-framework/Builder/                       
;-===="="=======================================================================

github: @libdeflate

version: 0.1.0

compiler: clang
arch:     x64
optimize: 2

define: USE_TRACES

;- options common for all Rebol extensions ----------------------
flag:   shared

#if Windows? [
	define: _CRT_SECURE_NO_WARNINGS
	define: TO_WINDOWS
]
#if Linux? [
	compiler: gcc
]

target-x86: [
	arch: x86
]
target-x64: [
	arch: x64
	defines: [
		_FILE_OFFSET_BITS=64
		__LP64__       ; has long (integer) 64 bits
	]
	#if macOS?   [ flag: "-arch x86_64" ]
]
target-arm64: [
	arch: arm64
	#if Linux? [
		flag: "-arch arm64"
	]
	#if macOS? [
		flag: "-target arm64-apple-darwin"
	]
	define: _FILE_OFFSET_BITS=64
	define: __LP64__   ; has long (integer) 64 bits
	define: __arm64__
]
target-armv7: [
	arch: armv7
	flag: "-march=armv7"
]
;----------------------------------------------------------------


r3-extension: [
	flags:  shared
	include: %libdeflate/lib
	include: %libdeflate
	source: %src/

	strip:  on

	files: [
		%deflate-commands.c
		%deflate-commands-table.c
		%deflate-rebol-extension.c
	]
	#if macOS? [
		lflags:  [-dynamiclib]
		flag:    -mmacosx-version-min=10.9
		compiler: clang
	]
	#if Posix? [
		cflags: [-fPIC -pthread]
		libraries: [%pthread]
	]
	#if Windows? [
		upx: on
	]
	;- generate main extension header --------------------------------
	do %src/deflate-rebol-extension.r3 
]

deflate-src: [
	source:  %libdeflate/lib/
	files: [
		%adler32.c
		%crc32.c
		%deflate_compress.c
		%deflate_decompress.c
		%gzip_compress.c
		%gzip_decompress.c
		%utils.c
		%zlib_compress.c
		%zlib_decompress.c
		;%x86/cpu_features.c
		;%arm/cpu_features.c
	]
]

eggs: [
	#if Windows? [
		"Make deflate static library (cmake) - x86" [
			arch: x86
			name: %static-lib-x86
			cmd %_static_x86/ "cmake ../libdeflate/ -A Win32 -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF"
			cmd %_static_x86/ {cmake --build . --config release -j 8}
		]
		"Make Brotli static library (cmake) - x64" [
			arch: x64
			name: %static-lib-x64
			cmd %_static_x64/ "cmake ../libdeflate/ -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF"
			cmd %_static_x64/ {cmake --build . --config release -j 8}
		]
		"Rebol deflate extension: win32_x86" [
			name: %deflate-windows-x86
			:target-x86
			:r3-extension
			:deflate-src
			file: %x86/cpu_features.c
		]
		"Rebol deflate extension: win32_x64" [
			name: %deflate-windows-x64
			:target-x64
			:r3-extension
			:deflate-src
			file: %x86/cpu_features.c
		]
	]
	#if macOS? [
		"Rebol deflate extension: macos_x64" [
			name: %deflate-macos-x64
			:r3-extension
			:deflate-src
			:target-x64
			file: %x86/cpu_features.c
		]
		"Rebol deflate extension: macos_arm64" [
			name: %deflate-macos-arm64
			:r3-extension
			:deflate-src
			:target-arm64
			file: %arm/cpu_features.c
		]
	]
	#if Linux? [
		"Make deflate static library (cmake) - x64" [
			arch: x64
			name: %static-lib-x64
			cmd %_static_nix_x64/ "cmake ../libdeflate/ -DLIBDEFLATE_BUILD_SHARED_LIB=OFF -DLIBDEFLATE_BUILD_STATIC_LIB=ON -DCMAKE_VERBOSE_MAKEFILE=OFF -DCMAKE_BUILD_TYPE=Release -DCMAKE_POSITION_INDEPENDENT_CODE=ON"
			cmd %_static_nix_x64/ {cmake --build . --config release -j 8}
		]
		"Rebol deflate extension: linux_x86" [
			name: %deflate-linux-x86
			:r3-extension
			:deflate-src
			:target-x86
			file: %x86/cpu_features.c
		]
		"Rebol deflate extension: linux_x64" [
			name: %deflate-linux-x64
			:r3-extension
			:deflate-src
			:target-x64
			file: %x86/cpu_features.c
		]
		"Rebol deflate extension: linux_arm64" [
			name: %deflate-linux-arm64
			:r3-extension
			:deflate-src
			:target-arm64
			file: %arm/cpu_features.c
		]
	]
]

